# Normaliza finales de línea en texto; nunca toca binarios.
* text=auto eol=lf

*.kt    text eol=lf
*.kts   text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.sq    text eol=lf
*.toml  text eol=lf

gradlew text eol=lf
gradlew.bat text eol=crlf

# Binarios
*.zip   binary
*.jar   binary
*.apk   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.kra   binary
*.keystore binary
