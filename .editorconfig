root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{toml,properties}]
indent_size = 2

[*.sq]
indent_size = 4

[*.sh]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.{zip,jar,apk,png,jpg,jpeg,webp,ico,kra}]
insert_final_newline = false
