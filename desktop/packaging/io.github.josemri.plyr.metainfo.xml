<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ficha AppStream del escritorio (M14). jpackage genera el `.desktop` y el
  icono, pero no esta metadata, que es la que usan GNOME Software / KDE
  Discover para mostrar la app. El `launchable` apunta al `.desktop` que
  instala jpackage (nombrado `<paquete>-<app>.desktop`).
-->
<component type="desktop-application">
  <id>io.github.josemri.plyr</id>
  <name>plyr</name>
  <summary>Reproductor de música minimalista</summary>
  <developer id="io.github.josemri">
    <name>josemri</name>
  </developer>
  <description>
    <p>
      Reproductor de música con estética de terminal. Reproduce audio de YouTube
      sin clave de API y gestiona listas locales, con integración MPRIS para las
      teclas multimedia y los metadatos del sistema.
    </p>
  </description>
  <launchable type="desktop-id">plyr-plyr.desktop</launchable>
  <url type="homepage">https://github.com/josemri/plyr</url>
  <url type="bugtracker">https://github.com/josemri/plyr/issues</url>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <categories>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.3.0" date="2026-10-13"/>
  </releases>
</component>
