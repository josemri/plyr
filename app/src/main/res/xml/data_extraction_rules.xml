<?xml version="1.0" encoding="utf-8"?><!--
  Reglas de copia de seguridad y transferencia de dispositivo (API >= 31).

  Mantiene el mismo criterio que `backup_rules.xml` (API <= 30), con la
  diferencia de que aquí `cloud-backup` y `device-transfer` se controlan por
  separado. La transferencia entre dispositivos se deja completa a propósito:
  mover un móvil a otro es justo cuando más falta hacen las listas, y no implica
  subir nada a la nube.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="covers/" />
        <include domain="sharedpref" path="plyr_config.xml" />
        <exclude domain="file" path="export-covers/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="covers/" />
        <include domain="file" path="export-covers/" />
        <include domain="sharedpref" path="plyr_config.xml" />
    </device-transfer>
</data-extraction-rules>
